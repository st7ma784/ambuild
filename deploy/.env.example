# Copy to deploy/.env and change before using the stack for anything but local development
POSTGRES_PASSWORD=change-me
S3_ACCESS_KEY=ambuild
S3_SECRET_KEY=change-me-too
AMBUILD_S3_BUCKET=ambuild-runs
# Directory of recorded runs that the uploader service scans
AMBUILD_RUNS_DIR=./runs
# The demo agent's token for the web GUI (registered by web-init; any long random string)
AMBUILD_AGENT_TOKEN=change-me-three
