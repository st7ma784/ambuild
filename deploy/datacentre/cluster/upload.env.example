# The cluster user's upload settings: ~/.config/ambuild/upload.env, chmod 600 (the
# directory 700). The Slurm upload jobs, and live uploads while a build runs, read it on
# the compute nodes; builds never see it. Plain KEY=value lines, no trailing comments.
# Needed for both Slurm agents (slurm and slurmrest).

DATABASE_URL=postgresql://ambuild:CHANGE-ME@db.lab.internal:5432/ambuild
AMBUILD_S3_BUCKET=ambuild-runs
S3_ENDPOINT_URL=http://s3.lab.internal:8333
AWS_ACCESS_KEY_ID=ambuild
AWS_SECRET_ACCESS_KEY=CHANGE-ME
AWS_DEFAULT_REGION=us-east-1
