# The object-storage machine's settings (copy to storage.env, chmod 600)

# becomes AWS_ACCESS_KEY_ID everywhere else
S3_ACCESS_KEY=ambuild
# e.g. openssl rand -hex 24; becomes AWS_SECRET_ACCESS_KEY everywhere else
S3_SECRET_KEY=CHANGE-ME
BIND_ADDRESS=0.0.0.0
# the big disks
DATA_DIR=/srv/ambuild/s3data
