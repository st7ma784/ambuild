# The database machine's settings (copy to database.env, chmod 600). Comments stay on
# their own lines: some readers keep a trailing comment as part of the value.

# e.g. openssl rand -hex 24; it goes into every DATABASE_URL
POSTGRES_PASSWORD=CHANGE-ME
# or this host's address on the service network
BIND_ADDRESS=0.0.0.0
# on fast local storage; back it up (pg_dump)
DATA_DIR=/srv/ambuild/pgdata
