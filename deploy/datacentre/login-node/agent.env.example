# The login-node agent's settings (~/.config/ambuild/agent.env, chmod 600), read by
# ambuild-agent.service. Plain KEY=value lines: systemd does not expand ~ or $VARIABLES.

AMBUILD_API_URL=https://ambuild.lab.internal
# from the web machine's init (--agent hpc:slurm) or its Agents page (backend slurm)
AMBUILD_AGENT_TOKEN=CHANGE-ME
AMBUILD_AGENT_BACKEND=slurm
# on the shared filesystem, visible to every compute node
AMBUILD_RUNS_ROOT=/shared/ambuild/runs
# the clone's deploy/slurm (submit_build.sh and the job scripts)
AMBUILD_SLURM_DIR=/home/USER/ambuild/deploy/slurm
AMBUILD_SLURM_PARTITION=cpu
AMBUILD_SLURM_OPTIONS=--account=chem
# the upload settings (the agent's live uploads and the upload jobs use them)
AMBUILD_UPLOAD_ENV=/home/USER/.config/ambuild/upload.env
# the jobs inherit this environment: put the venv first
PATH=/home/USER/ambuild-venv/bin:/usr/local/bin:/usr/bin:/bin
# Ambuild's force-field parameters (tests/params of a clone), needed by recipes
AMBUILD_PARAMS_DIR=/home/USER/ambuild/tests/params
POREBLAZER_EXE=/shared/ambuild/bin/poreblazer.exe
