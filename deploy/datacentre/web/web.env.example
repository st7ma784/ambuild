# The web machine's settings (copy to web.env, chmod 600)

# ghcr.io image tag: latest, sha-<commit>, or a release such as 0.1.0
AMBUILD_TAG=latest
# the database machine; add ?sslmode=require if PostgreSQL has TLS
DATABASE_URL=postgresql://ambuild:CHANGE-ME@db.lab.internal:5432/ambuild
# the object-storage machine (or your MinIO / Ceph RGW / cloud S3)
S3_ENDPOINT_URL=http://s3.lab.internal:8333
AMBUILD_S3_BUCKET=ambuild-runs
AWS_ACCESS_KEY_ID=ambuild
AWS_SECRET_ACCESS_KEY=CHANGE-ME
# 127.0.0.1 behind a reverse proxy on this machine; else this host's service address
BIND_ADDRESS=127.0.0.1
AMBUILD_WEB_TITLE=Ambuild
