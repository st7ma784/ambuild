# The slurmrest agent's settings (copy to agent.env, chmod 600). JSON values are in single
# quotes so Compose keeps them as they are.

AMBUILD_TAG=latest
# the web GUI, as this machine reaches it
AMBUILD_API_URL=https://ambuild.lab.internal
# from the web machine's init (--agent hpc:slurm) or its Agents page (backend slurm)
AMBUILD_AGENT_TOKEN=CHANGE-ME
# slurmrestd, usually on the Slurm controller or a service node (https behind a proxy)
AMBUILD_SLURMRESTD_URL=http://slurm-head.lab.internal:6820
# the cluster user the jobs run as; the JWT in slurm.jwt must be this user's
AMBUILD_SLURM_USER=ambuild
# on the cluster's shared filesystem, writable by that user
AMBUILD_RUNS_ROOT=/shared/ambuild/runs
AMBUILD_SLURM_PARTITION=cpu
# run first in every job: make python (with ambuild) and ambuild-upload available
AMBUILD_SLURM_SETUP=source /shared/ambuild/venv/bin/activate
# the jobs' whole environment: through slurmrestd they inherit nothing. AMBUILD_PARAMS_DIR
# (force-field parameters) is needed unless the environment sets it (the published image does)
AMBUILD_SLURMREST_ENV='{"PATH": "/usr/local/bin:/usr/bin:/bin", "AMBUILD_PARAMS_DIR": "/shared/ambuild/params", "POREBLAZER_EXE": "/shared/ambuild/bin/poreblazer.exe"}'
# more job fields, e.g. an account or QOS
AMBUILD_SLURMREST_JOB='{"account": "chem"}'
# empty: the newest tested version slurmrestd offers (v0.0.42, v0.0.41, v0.0.40)
AMBUILD_SLURMRESTD_VERSION=
