# A local agent's settings (copy to agent.env, chmod 600)

AMBUILD_TAG=latest
AMBUILD_API_URL=https://ambuild.lab.internal
# from the web machine's init (--agent box1:local) or its Agents page (backend local)
AMBUILD_AGENT_TOKEN=CHANGE-ME
# builds at once, and the CPUs the container may use
AMBUILD_AGENT_SLOTS=2
AMBUILD_AGENT_CPUS=4
# as on the web machine
DATABASE_URL=postgresql://ambuild:CHANGE-ME@db.lab.internal:5432/ambuild
S3_ENDPOINT_URL=http://s3.lab.internal:8333
AMBUILD_S3_BUCKET=ambuild-runs
AWS_ACCESS_KEY_ID=ambuild
AWS_SECRET_ACCESS_KEY=CHANGE-ME
