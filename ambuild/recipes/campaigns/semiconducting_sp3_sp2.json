{
  "parameters": [
    {"name": "box", "path": "/cell/box", "all": true, "type": "float", "low": 40, "high": 60},
    {"name": "grow", "path": "/stages/1/stages/0/count", "type": "int", "low": 30, "high": 80},
    {"name": "passes", "path": "/stages/1/repeat", "type": "int", "low": 5, "high": 10}
  ],
  "constraints": [{"metric": "el_radical_domains", "max": 0},
                  {"metric": "percolated_dimensions", "min": 1}],
  "objective": {"maximise": "el_conductance"},
  "replicates": 3, "method": "tpe", "initial_points": 8, "batch_size": 6,
  "budget": {"runs": 90}, "stop": {"no_improvement_rounds": 4}
}
