{
  "recipe_version": 1,
  "name": "Biaryl network: Li+, Na+ and K+ maps",
  "description": "Benzene rings linked directly to each other at 1,3,5 (biaryl bonds, as in porous aromatic frameworks and conjugated microporous polymers): seeded, grown and zipped into a network, with a rigid-body geometry optimisation (GAFF 1.81, params/gaff_benzene_alkyne; linking carbons typed cp, links 1.4854 A) after each pass, then analysed with Poreblazer. The same build as benzene_network, then mapped for Li+, Na+ and K+ with liminal (an ion_map stage, LIMINAL_EXE; docs/ion-maps.md). Its pores are narrower than li_ion_carbon's, so the three ions differ more.",
  "cell": {
    "box": [
      30,
      30,
      30
    ],
    "bond_margin": 0.5,
    "bond_angle_margin": 15,
    "typed_bond_lengths": true
  },
  "fragments": [
    {
      "type": "A",
      "car": "benzene_135.car",
      "csv": "benzene_135.csv",
      "name": "benzene_135"
    }
  ],
  "params": {
    "angle_params.csv": "params/gaff_benzene_alkyne/angle_params.csv",
    "bond_params.csv": "params/gaff_benzene_alkyne/bond_params.csv",
    "dihedral_params.csv": "params/gaff_benzene_alkyne/dihedral_params.csv",
    "improper_params.csv": "params/gaff_benzene_alkyne/improper_params.csv",
    "pair_params.csv": "params/gaff_benzene_alkyne/pair_params.csv"
  },
  "bond_types": [
    "A:a-A:a"
  ],
  "stages": [
    {
      "op": "seed",
      "count": 10
    },
    {
      "repeat": 6,
      "stages": [
        {
          "op": "grow",
          "count": 10,
          "max_tries": 50
        },
        {
          "op": "zip",
          "bond_margin": 1.0,
          "bond_angle_margin": 30
        },
        {
          "op": "optimise",
          "cycles": 20000,
          "rigid_body": true,
          "do_dihedral": true
        }
      ]
    },
    {
      "op": "poreblazer",
      "threads": 2
    },
    {
      "op": "ion_map",
      "ions": [
        "Li+",
        "Na+",
        "K+"
      ],
      "spacing": 0.5,
      "max_paths": 20
    }
  ],
  "seed": 3
}
